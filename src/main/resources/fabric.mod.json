{
  "schemaVersion": 1,
  "id": "ogpots",
  "version": "${version}",
  "name": "OG Pots",
  "description": "Brings back the enchantment glint on potions, from Minecraft 1.21 up to 26.3. Code modified on the basis of the Shiny Pots project by nukebob (https://modrinth.com/mod/shiny-pots), used under CC-BY-4.0.",
  "authors": [
    "betongoat"
  ],
  "contributors": [
    "nukebob (original Shiny Pots)"
  ],
  "contact": {
    "homepage": "https://github.com/betongoat/og-pots",
    "sources": "https://github.com/betongoat/og-pots",
    "issues": "https://github.com/betongoat/og-pots/issues"
  },
  "license": "CC-BY-4.0",
  "icon": "assets/ogpots/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "net.betongoat.ogpots.OgPots"
    ]
  },
  "mixins": [
    "ogpots.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": ">=1.21 <26.4-",
    "java": ">=21"
  }
}
